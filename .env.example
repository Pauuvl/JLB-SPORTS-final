# ── Copia este archivo a .env y completa los valores reales ────────
# NUNCA subas el archivo .env real a git (ya está en .gitignore).

# Entorno: development | production | testing
FLASK_ENV=production

# Clave secreta para sesiones/CSRF — genera una nueva con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Cadena de conexión a PostgreSQL.
# Render/Railway la inyectan automáticamente como DATABASE_URL.
# Formato: postgresql://usuario:password@host:puerto/nombre_bd
DATABASE_URL=postgresql://jlb_user:jlb_password@localhost:5432/jlb_sports

# Umbral de negocio
LOW_STOCK_DEFAULT=5
UNUSUAL_SALE_MULTIPLIER=3

# Puerto (Render/Railway lo inyectan automáticamente)
PORT=5000

# Cola de mensajes para Socket.IO en despliegues multi-worker (opcional).
# Si se deja vacío, Socket.IO funciona igual pero solo con 1 worker.
# SOCKETIO_MESSAGE_QUEUE=redis://localhost:6379/0

LOG_LEVEL=INFO
LOG_TO_STDOUT=1
